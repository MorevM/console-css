{
	"name": "@morev/console-css",
	"description": "Style browser console messages with CSS",
	"type": "module",
	"version": "0.0.5",
	"private": false,
	"packageManager": "pnpm@11.28.11",
	"license": "MIT",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"author": {
		"name": "Maxim Morev",
		"email": "max.seainside@gmail.com"
	},
	"homepage": "https://github.com/MorevM/console-css#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/MorevM/console-css"
	},
	"keywords": [],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/console-css.d.ts",
				"default": "./dist/console-css.es.js"
			},
			"require": {
				"types": "./dist/console-css.d.cts",
				"default": "./dist/console-css.cjs"
			}
		}
	},
	"main": "./dist/console-css.cjs",
	"module": "./dist/console-css.es.js",
	"browser": "./dist/console-css.umd.js",
	"types": "./dist/console-css.d.ts",
	"scripts": {
		"dev": "vite example --port=3000",
		"build": "tsdown",
		"prepare": "husky install ./.husky",
		"vscode-settings": "cp .vscode/settings.template.json .vscode/settings.json",
		"release": "release-it --disable-metrics",
		"lint": "pnpm lint:eslint",
		"lint:fix": "pnpm lint:eslint:fix",
		"lint:eslint": "eslint \"**/*.{js,ts,json,json5,jsonc,yml,yaml}\"",
		"lint:eslint:fix": "eslint \"**/*.{js,ts,json,json5,jsonc,yml,yaml}\" --fix",
		"test": "pnpm build && tsc -p tests/tsconfig.json && vitest run --environment jsdom",
		"typecheck": "tsc --noEmit",
		"prepack": "pnpm build"
	},
	"devDependencies": {
		"@commitlint/cli": "^16.2.3",
		"@morev/commitlint-config": "^0.1.1",
		"@morev/eslint-config": "^17.6.3",
		"@morev/utils": "^3.15.0",
		"@release-it/conventional-changelog": "^5.1.1",
		"@types/node": "24",
		"eslint": "^8.26.0",
		"husky": "^8.0.1",
		"jsdom": "^29.0.0",
		"lint-staged": "^13.0.3",
		"release-it": "^15.5.0",
		"tsdown": "^0.23.0",
		"typescript": "~6.0.3",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	}
}
