{
	"name": "@morev/console-css",
	"description": "Style browser console messages with CSS",
	"type": "module",
	"private": false,
	"version": "0.0.5",
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": ">=20"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/",
		"provenance": true
	},
	"author": {
		"name": "Maxim Morev",
		"email": "max.seainside@gmail.com"
	},
	"homepage": "https://github.com/MorevM/console-css#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/MorevM/console-css"
	},
	"keywords": [
		"browser",
		"console",
		"console-log",
		"css",
		"devtools",
		"logging",
		"styled-console"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/console-css.d.ts",
				"default": "./dist/console-css.es.js"
			},
			"require": {
				"types": "./dist/console-css.d.cts",
				"default": "./dist/console-css.cjs"
			}
		}
	},
	"main": "./dist/console-css.cjs",
	"module": "./dist/console-css.es.js",
	"browser": "./dist/console-css.umd.js",
	"types": "./dist/console-css.d.ts",
	"scripts": {
		"dev": "vite playground --port 3000",
		"build": "tsdown",
		"prepare": "pnpm build && lefthook install",
		"release": "release-it",
		"lint": "pnpm lint:eslint",
		"lint:fix": "pnpm lint:eslint:fix",
		"lint:eslint": "eslint .",
		"lint:eslint:fix": "eslint . --fix",
		"test": "pnpm build && tsc -p tests/tsconfig.json && vitest run --environment jsdom",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@morev/commitlint-config": "^0.2.2",
		"@morev/eslint-config": "^43.0.0",
		"@morev/utils": "^3.15.0",
		"@release-it/conventional-changelog": "^12.0.2",
		"@types/node": "24",
		"eslint": "^10.10.0",
		"jsdom": "^29.0.0",
		"lefthook": "^2.1.14",
		"release-it": "^21.0.3",
		"tsdown": "^0.23.0",
		"typescript": "~6.0.3",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	}
}
